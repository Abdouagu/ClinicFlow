# Application Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection Strings
# DATABASE_URL : URL du pooler de connexions (Transaction pooling)
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinicflow?sslmode=disable
# DATABASE_URL_DIRECT : URL de connexion directe (indispensable pour les migrations Drizzle)
DATABASE_URL_DIRECT=postgresql://clinic_user:clinic_password@localhost:5432/clinicflow?sslmode=disable

# Authentication & Security
# Clé secrète JWT : minimum 32 caractères requis
JWT_SECRET=clinicflow_super_secure_jwt_secret_key_min_32_characters_random
JWT_EXPIRES_IN=8h

# Security Shield & Bot Detection (Arcjet)
ARCJET_KEY=ajkey_your_arcjet_api_key_here

# Frontend Application Origin (CORS & CSRF Defense)
CLIENT_ORIGIN=http://localhost:5173

# Clinic Business Timezone (ex: Africa/Casablanca, Europe/Paris)
CLINIC_TIMEZONE=Africa/Casablanca
